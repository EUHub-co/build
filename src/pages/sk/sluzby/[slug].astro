---
import ServiceDetailPage from '../../../components/services/ServiceDetailPage.astro';
import { getServicePages } from '../../../content/service-pages';

export function getStaticPaths() {
  return getServicePages('sk').map((page) => ({
    params: { slug: page.paths.sk.split('/').filter(Boolean).at(-1) },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<ServiceDetailPage locale="sk" page={page} />
