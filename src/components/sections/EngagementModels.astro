---
/**
 * Engagement Models — pricing shapes (not another service list).
 * Per plan v3 / Fable B6: describes HOW you buy, not WHAT you buy.
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { getContent } from '../../lib/i18n';
import type { Locale } from '../../content/types';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { engagementModels, pricingOrientationCopy } =
  getContent(locale).engagement;
const { primaryCta } = getContent(locale).site;
const { engagement } = getContent(locale).ui;
---

<Section id="pricing" bg="surface-2">
  <Container>
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2
        class="font-heading text-h2 font-bold tracking-tight text-(--color-text-primary)"
      >
        {engagement.heading}
      </h2>
      <p class="mt-4 text-lead text-(--color-text-secondary)">
        {pricingOrientationCopy}
      </p>
    </div>

    <div
      class="mt-16 overflow-x-auto rounded-lg border border-(--color-border-subtle) bg-surface-raised shadow-card"
    >
      <table class="w-full min-w-[840px] border-collapse text-left">
        <caption class="sr-only">{engagement.comparisonCaption}</caption>
        <thead class="bg-surface-sunken">
          <tr>
            {
              [
                engagement.modelHeading,
                engagement.approachHeading,
                engagement.priceHeading,
                engagement.scopeHeading,
                engagement.actionHeading,
              ].map((heading) => (
                <th
                  scope="col"
                  class="border-b border-(--color-border-subtle) px-5 py-4 text-xs font-semibold uppercase tracking-wider text-(--color-text-secondary)"
                >
                  {heading}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            engagementModels.map((model, i) => (
              <tr class={i === 1 ? 'bg-primary-50' : undefined}>
                <th
                  scope="row"
                  class="border-b border-(--color-border-subtle) px-5 py-5 align-top font-heading text-base font-semibold text-(--color-text-primary)"
                >
                  {model.shape}
                  {i === 1 && (
                    <span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-primary-500">
                      {engagement.mostCommon}
                    </span>
                  )}
                </th>
                <td class="border-b border-(--color-border-subtle) px-5 py-5 align-top text-sm leading-relaxed text-(--color-text-secondary)">
                  {model.howItWorks}
                </td>
                <td class="border-b border-(--color-border-subtle) px-5 py-5 align-top text-sm font-bold text-primary-500">
                  {model.priceOrientation}
                </td>
                <td class="border-b border-(--color-border-subtle) px-5 py-5 align-top text-sm text-(--color-text-secondary)">
                  {model.typicalScope}
                </td>
                <td class="border-b border-(--color-border-subtle) px-5 py-5 align-top">
                  <Button
                    href={primaryCta.href}
                    variant={i === 1 ? 'primary' : 'secondary'}
                    size="sm"
                    data-umami-event="cta_primary_click"
                  >
                    {i === 0
                      ? engagement.requestAudit
                      : engagement.startConversation}
                  </Button>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Container>
</Section>
