---
/**
 * Differentiation — "Design is only the visible layer."
 * 5-layer stack visual proving engineering-led approach.
 */
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getContent } from '../../lib/i18n';
import type { Locale } from '../../content/types';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { differentiation } = getContent(locale).ui;

const layers = [
  {
    n: 1,
    title: differentiation.layers[0].title,
    desc: differentiation.layers[0].description,
    icon: 'layout',
    color: 'text-primary-500',
    bg: 'bg-primary-50',
  },
  {
    n: 2,
    title: differentiation.layers[1].title,
    desc: differentiation.layers[1].description,
    icon: 'code',
    color: 'text-accent-cyan',
    bg: 'bg-accent-cyan/10',
  },
  {
    n: 3,
    title: differentiation.layers[2].title,
    desc: differentiation.layers[2].description,
    icon: 'plug',
    color: 'text-accent-violet',
    bg: 'bg-accent-violet/10',
  },
  {
    n: 4,
    title: differentiation.layers[3].title,
    desc: differentiation.layers[3].description,
    icon: 'zap',
    color: 'text-status-warning',
    bg: 'bg-status-warning-bg',
  },
  {
    n: 5,
    title: differentiation.layers[4].title,
    desc: differentiation.layers[4].description,
    icon: 'shield',
    color: 'text-status-success',
    bg: 'bg-status-success-bg',
  },
];
---

<Section id="differentiation" bg="surface-2">
  <Container>
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <Eyebrow index={4} label={differentiation.eyebrow} class="mb-4" />
      <h2
        class="font-heading text-h2 font-bold tracking-tight text-(--color-text-primary)"
      >
        {differentiation.heading}
      </h2>
      <p class="mt-4 text-lead text-(--color-text-secondary)">
        {differentiation.lead}
      </p>
    </div>

    {/* Layered visual */}
    <div class="mx-auto mt-16 max-w-2xl space-y-3">
      {
        layers.map((layer) => (
          <div
            class={`flex items-center gap-4 rounded-lg border bg-surface-raised p-5 shadow-card ${
              layer.n === 1
                ? 'border-primary-500/40'
                : 'border-(--color-border-subtle)'
            }`}
          >
            <div
              class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-lg ${layer.bg} ${layer.color}`}
            >
              <Icon name={layer.icon} size={24} />
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-semibold text-primary-500">
                  L{layer.n}
                </span>
                <h3 class="font-heading text-base font-semibold text-(--color-text-primary)">
                  {layer.title}
                </h3>
              </div>
              <p class="mt-1 text-sm text-(--color-text-secondary)">
                {layer.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div
      class="mx-auto mt-12 max-w-2xl rounded-lg border border-primary-500/20 bg-primary-50 p-6 text-center"
    >
      <p class="text-lg font-medium text-primary-500">
        {differentiation.conclusion}
      </p>
    </div>
  </Container>
</Section>
